# ─────────────────────────────────────────────────────────────
# 织音（ZhiYin）· DSH 插件仓库忽略规则
# 生成：git-manager 技能（新建文件，未覆盖任何既有文件）
# 栈：Node ESM 插件包在仓库根目录（package-lock.json 入库）；开发文档在 docs/
# ─────────────────────────────────────────────────────────────

# 依赖目录（不带前导斜杠，任意层级生效，覆盖 prototype/node_modules）
node_modules/

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 构建产物
dist/
build/
*.tsbuildinfo

# 覆盖率与测试产物
coverage/
*.lcov
.nyc_output/

# 缓存与工具产物
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.node_repl_history
*.tgz
.yarn-integrity
.codegraph/

# 本地环境与密钥（示例文件保持可追踪）
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# 临时文件
.tmp/
tmp/
temp/
*.tmp
*.temp

# DSH 运行时产物：会话附件图片，不入库
.dsh-file-attachment/

# 操作系统临时文件
.DS_Store
Thumbs.db
desktop.ini

# 织音调试产物（宿主 state 快照转储与临时验证脚本）
.tmp-state.json

# 设计/调研的一次性工作目录（HTML demo、截图、临时产物）
_temp/
.impeccable/

# 打包与本地验证输出
*.zip
pack-out/

# 临时验收实例（隔离 DSH_HOME + 假数据，不入库）
.verify-tmp/
