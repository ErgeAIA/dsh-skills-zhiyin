{
  "name": "dsh-skills-zhiyin",
  "version": "0.1.3",
  "type": "module",
  "description": "织音：把散落的技能织成一支谱——装技能、编技能包、按需启停，模型只奏你想要的声部。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skills",
    "skill-manager"
  ],
  "icon": "icon-small.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "paths.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "assets/banner.svg",
    "assets/banner.json",
    "assets/logo.svg",
    "assets/banner-en.svg",
    "NOTICE",
    "LICENSE",
    "assets/icon-180.png",
    "assets/icon-512.png",
    "icon-small.svg",
    "assets/wordmark.svg",
    "assets/wordmark-light.svg",
    "assets/logo-light.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErgeAIA/dsh-skills-zhiyin.git"
  },
  "homepage": "https://github.com/ErgeAIA/dsh-skills-zhiyin#readme",
  "bugs": {
    "url": "https://github.com/ErgeAIA/dsh-skills-zhiyin/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
